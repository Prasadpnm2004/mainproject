# PACM Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── LLM API Keys ─────────────────────────────────────────────────────────────
# OpenAI (GPT-4o, GPT-4-turbo, etc.)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (Claude-3.5-Sonnet, Claude-3-Haiku, etc.)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Experiment Control ────────────────────────────────────────────────────────
# Default model for baseline runs (see src/harness/langgraph_agent.py)
PACM_DEFAULT_MODEL=gpt-4o-mini

# Maximum tool-call iterations per agent run (prevents runaway API costs)
PACM_MAX_ITERATIONS=10

# ── Logging ───────────────────────────────────────────────────────────────────
# Directory where JSONL run logs are written
PACM_LOG_DIR=experiments/logs

# Log verbosity: DEBUG | INFO | WARNING | ERROR
PACM_LOG_LEVEL=INFO
