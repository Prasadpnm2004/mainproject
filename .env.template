# PACM Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── LLM Provider Selection ────────────────────────────────────────────────────
# Choose "openai" (default) or "ollama" (local, free, no API key needed).
#
# To use Ollama:
#   1. Install Ollama: https://ollama.com/download
#   2. Pull a tool-calling model:
#         ollama pull qwen3:8b        (recommended, ~5 GB)
#         ollama pull llama3.1:8b    (alternative, ~5 GB)
#   3. Set LLM_PROVIDER=ollama below (other fields can stay commented out).
#   4. Verify with: python -m experiments.probe_llm_backend
#
# NOTE: Not all Ollama models support structured tool_calls. Use only the
# models listed above or check probe_llm_backend output before running a sweep.
LLM_PROVIDER=openai

# Model name.
#   openai:  gpt-4o-mini | gpt-4o | gpt-4-turbo
#   ollama:  qwen3:8b | qwen3:14b | llama3.1:8b | mistral:7b-instruct
LLM_MODEL=gpt-4o-mini

# API base URL (leave blank for provider defaults).
#   openai:  blank → https://api.openai.com/v1
#   ollama:  blank → http://localhost:11434/v1  (auto-set when provider=ollama)
#LLM_BASE_URL=

# API key.
#   openai: your real key (sk-...)
#   ollama: leave blank or "ollama" — value is ignored by local Ollama server
#LLM_API_KEY=

# ── LLM API Keys (legacy / direct) ───────────────────────────────────────────
# OPENAI_API_KEY is still read as a fallback when LLM_PROVIDER=openai and
# LLM_API_KEY is not set.
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (Claude-3.5-Sonnet, Claude-3-Haiku, etc.)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Experiment Control ────────────────────────────────────────────────────────
# Default model for baseline runs. Overridden by LLM_MODEL when set.
PACM_DEFAULT_MODEL=gpt-4o-mini

# Maximum tool-call iterations per agent run (prevents runaway API costs)
PACM_MAX_ITERATIONS=10

# ── Logging ───────────────────────────────────────────────────────────────────
# Directory where JSONL run logs are written
PACM_LOG_DIR=experiments/logs

# Log verbosity: DEBUG | INFO | WARNING | ERROR
PACM_LOG_LEVEL=INFO
